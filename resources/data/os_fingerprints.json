    "display": ["drm", "fb", "panel", "lvds", "vbo", "vby1", "mali", "gpu", "pq", "hdmi", "disp", "tcon"],
    "network": ["eth", "gmac", "r8152", "asix", "usbnet", "emac"],
    "tuner_demod": ["tuner", "demod", "dvb", "atsc", "isdb", "frontend"],
    "usb": ["usb", "ehci", "xhci", "ohci", "dwc"],
    "storage": ["mmc", "emmc", "nand", "ubi", "spi_nor", "sdhci"]
